<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below.
    Excludes all SharedPreferences files that contain sensitive data:
    emergency state, cached profiles, and authentication tokens.
-->
<full-backup-content>
    <!-- Exclude the DQRA repository cache (cached user/admin profiles, stations) -->
    <exclude domain="sharedpref" path="dqra_repository_cache.xml" />

    <!-- Exclude emergency state preferences (emergency IDs, coordinates, status) -->
    <exclude domain="sharedpref" path="emergency_preferences.xml" />

    <!-- Exclude EmergencyPrefs used by FirestoreService (last processed timestamp) -->
    <exclude domain="sharedpref" path="EmergencyPrefs.xml" />

    <!-- Exclude general app preferences (first_launch flag) -->
    <exclude domain="sharedpref" path="app_prefs.xml" />
</full-backup-content>
