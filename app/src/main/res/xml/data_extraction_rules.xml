<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Controls both cloud backup and device-to-device transfer.
    Excludes all SharedPreferences containing sensitive data.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Exclude the DQRA repository cache (cached user/admin profiles, stations) -->
        <exclude domain="sharedpref" path="dqra_repository_cache.xml" />

        <!-- Exclude emergency state preferences (emergency IDs, coordinates, status) -->
        <exclude domain="sharedpref" path="emergency_preferences.xml" />

        <!-- Exclude EmergencyPrefs used by FirestoreService -->
        <exclude domain="sharedpref" path="EmergencyPrefs.xml" />

        <!-- Exclude general app preferences -->
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Do not transfer any sensitive preferences to a new device -->
        <exclude domain="sharedpref" path="dqra_repository_cache.xml" />
        <exclude domain="sharedpref" path="emergency_preferences.xml" />
        <exclude domain="sharedpref" path="EmergencyPrefs.xml" />
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
