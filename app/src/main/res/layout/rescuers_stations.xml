<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Station Info Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Icon -->
            <TextView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="🚨"
                android:textSize="42sp"
                android:gravity="center"
                android:background="@drawable/textview_box"
                android:backgroundTint="#FFEBEE"/>

            <!-- Station Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/stationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rescue Station Name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvMunicipality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Municipality"
                    android:textSize="17sp"
                    android:textColor="#666666"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@android:drawable/ic_dialog_map"
                    android:drawablePadding="6dp"/>

                <TextView
                    android:id="@+id/stationPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="17sp"
                    android:textColor="#2196F3"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@android:drawable/stat_sys_phone_call"
                    android:drawablePadding="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Emergency Alert Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAction"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:text="🚨 SEND EMERGENCY ALERT"
                android:textSize="19sp"
                android:textStyle="bold"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white"
                app:cornerRadius="16dp"
                android:layout_marginBottom="14dp"/>

            <!-- Share Location Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMessenger"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="📱 SHARE LOCATION"
                android:textSize="17sp"
                android:backgroundTint="#0084FF"
                android:textColor="@android:color/white"
                app:cornerRadius="16dp"/>

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="use blue for mobile data use without load"
                android:textSize="13sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
