<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_menu_bg"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Registration Requests — with badge -->
    <LinearLayout
        android:id="@+id/menuItemRegistrationRequests"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/menu_item_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Requests"
            android:src="@drawable/icon_notification"
            android:tint="#FFA726" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Registration Requests"
            android:textColor="#111111"
            android:textSize="14sp" />

        <!-- Badge — shown only when count > 0 -->
        <TextView
            android:id="@+id/tvMenuItemBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#E8E8E8" />

    <!-- Emergency Contacts -->
    <LinearLayout
        android:id="@+id/menuItemEmergencyContacts"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/menu_item_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Emergency Contacts"
            android:src="@drawable/ic_contacts"
            android:tint="#555555" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contacts"
            android:textColor="#111111"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Help & Support -->
    <LinearLayout
        android:id="@+id/menuItemHelp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/menu_item_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Help"
            android:src="@drawable/ic_help"
            android:tint="#555555" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help and Support"
            android:textColor="#111111"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- About -->
    <LinearLayout
        android:id="@+id/menuItemAbout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/menu_item_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="About"
            android:src="@drawable/ic_info"
            android:tint="#555555" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textColor="#111111"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Divider before logout -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#E8E8E8" />

    <!-- Logout -->
    <LinearLayout
        android:id="@+id/menuItemLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/menu_item_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Logout"
            android:src="@drawable/ic_logout"
            android:tint="#C62828" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
