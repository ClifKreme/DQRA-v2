<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFA726">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== TOP BAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btnAddContactBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF"
                android:padding="10dp"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Emergency Contact"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/aclonica"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- ===== FORM CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_contacts"
                        android:tint="#FFA726"
                        android:contentDescription="Contact"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Contact Details"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Municipality / Barangay -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍  Municipality / Barangay"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etContactBarangay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Barotac Nuevo"
                    android:inputType="textCapWords"
                    android:background="@drawable/admin_register_field_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Station Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥  Station Name"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etContactStationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Barotac Nuevo Fire Station"
                    android:inputType="textCapWords"
                    android:background="@drawable/admin_register_field_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Phone Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞  Phone Number"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 09171234567"
                    android:inputType="phone"
                    android:background="@drawable/admin_register_field_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"/>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btnSaveContact"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/admin_register_btn_green"
                    android:text="Save Contact"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
