<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFA726">

    <!-- ===== TOP BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnEmergencyContactsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF"
            android:padding="10dp"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Contacts"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rescue station hotlines"
                android:textColor="#FFE0B2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== SEARCH BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/admin_register_field_bg"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_location"
            android:tint="#FFA726"
            android:contentDescription="Search location"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etSearchLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Filter by location (e.g. Barotac Nuevo)"
            android:textSize="13sp"
            android:textColor="#000000"
            android:background="@android:color/transparent"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:contentDescription="Search location filter"/>
    </LinearLayout>

    <!-- ===== EMPTY STATE ===== -->
    <TextView
        android:id="@+id/tvEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No emergency contacts found."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone"/>

    <!-- ===== RECYCLER VIEW ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmergencyContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:contentDescription="Emergency contacts list"/>

</LinearLayout>
