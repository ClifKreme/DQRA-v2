<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <!-- ══════════════════════════════════════════════ -->
        <!--  TOP BAR  — compact                           -->
        <!-- ══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_dashboard_header_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Title + municipality -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DQRA Admin"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAdminMunicipality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textColor="#FFCDD2"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════ -->
        <!--  STATS ROW  — compact chips                   -->
        <!-- ══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <!-- Pending chip -->
            <LinearLayout
                android:id="@+id/layoutPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/stat_card_pending_bg"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null">

                <TextView
                    android:id="@+id/tvPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dash_pending_text"
                    android:layout_marginEnd="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#BF360C"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tap"
                        android:textSize="9sp"
                        android:textColor="#E64A19"
                        android:alpha="0.7"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Active chip -->
            <LinearLayout
                android:id="@+id/layoutActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/stat_card_active_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null">

                <TextView
                    android:id="@+id/tvActiveCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dash_active_text"
                    android:layout_marginEnd="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tap"
                        android:textSize="9sp"
                        android:textColor="#C62828"
                        android:alpha="0.7"/>
                </LinearLayout>
            </LinearLayout>

            <!-- All Active chip -->
            <LinearLayout
                android:id="@+id/layoutOverallActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/stat_card_active_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null">

                <TextView
                    android:id="@+id/tvOverallActiveCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dash_active_text"
                    android:layout_marginEnd="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Active"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tap"
                        android:textSize="9sp"
                        android:textColor="#C62828"
                        android:alpha="0.7"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Resolved chip -->
            <LinearLayout
                android:id="@+id/layoutResolved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/stat_card_resolved_bg"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null">

                <TextView
                    android:id="@+id/tvResolvedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dash_resolved_text"
                    android:layout_marginEnd="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resolved"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tap"
                        android:textSize="9sp"
                        android:textColor="#2E7D32"
                        android:alpha="0.7"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════ -->
        <!--  EMERGENCY STATUS CARD — main focus           -->
        <!-- ══════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEmergencyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/emergency_card_idle_bg"
                android:padding="18dp">

                <!-- Status icon + main text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatusIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="34sp"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEmergencyAlert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No active emergencies"
                            android:textColor="@color/dash_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="1.4"/>

                        <TextView
                            android:id="@+id/tvEmergencyTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/dash_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_divider"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"/>

                <!-- Sender row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivSenderProfile"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/avatar_ring"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"/>

                    <TextView
                        android:id="@+id/tvSenderName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.2"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmergencyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.25"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════════ -->
        <!--  RESPOND SECTION — pending emergency          -->
        <!-- ══════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvEmergencyActionsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨  RESPOND"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"
            android:visibility="gone"/>

        <!-- Confirm / Reject -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="CONFIRM"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_confirm"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="REJECT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_reject"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Stop Alarm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnStopSound"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🔕  Stop Alarm"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_stop_alarm"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Mark Resolved -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnComplete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="✓  Mark as Resolved"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_resolve"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════ -->
        <!--  ACTIONS SECTION                              -->
        <!-- ══════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvInfoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIONS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/dash_text_secondary"
            android:letterSpacing="0.08"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"/>

        <!-- View Map — full width, most important action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnViewMap"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📍  View Location on Map"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_map"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Call + Messenger side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnCallSender"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📞  Call"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_call"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnShareMessenger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📨  Messenger"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_messenger"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- View Photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnViewImage"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📷  View Emergency Photo"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_call"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════ -->
        <!--  FOOTER — logs link                           -->
        <!-- ══════════════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_divider"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_logout"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
